  terminalText: {fileID: 444182405}
  consoleText: "> Start Boot\nPCI BUS 02, DEVICE 00, FUNCTION 00 = VENDOR 15AD, DEVICE
    0774\r\nIntelIntelIntelIntelIntelIntelPCI Bus02, Device 01, FUNCTION 00 = VENDOR
    8086, DEVICE 100f\r\nPCI BUS 02, DEVICE 02, FUNCTION 00 = VENDOR 1274, DEVICE
    1371\r\nPCI BUS 02, DEVICE 03, FUNCTION 00 = VENDOR 15AD, DEVICE 0770\r\nPCI
    BUS 02, DEVICE 03, FUNCTION 00 = VENDOR 15AD, DEVICE 07E0\r\n2674031465\r\nHardware
    init, Stage 2\r\n2681141683\r\nHardware init, Stage 3\r\nALBA KERNEL: interrupts
    activated\r\nNetwork init, Stage 4\r\nALBA KERNEL: eth0 init\r\nALBA KERNEL:
    ethframe obj init\r\nALBA KERNEL: ethframe sent\r\nACPI POWER INIT\r\nVALID RSDP
    FOUND\r\n=== ACPI Debug ===\r\nB2 SMI_CMD\r\nF0 ACPI_ENABLE\r\n04 PM1a_CNT\r\nSending
    SCPI_ENABLE to SMI_CMD...\r\nACPI enable timed out ... APM enabled\r\nJoin or
    Host A Lobby To Continue ... \r"
  charactersPerSecond: 250
  randomDelay: 0.015
  newlineDelay: 0.4
